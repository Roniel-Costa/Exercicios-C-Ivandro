algoritmo
    declare ALUNO registro (
        matrícula numerico,
        nome literal,
        curso literal,
        coeficiente_de_rendimento numérico,
    )

    declare TURMA[40] ALUNO
    declare i numérico

    Para i <- 0 até i < 40 faça passo 1
        inicio
            leia TURMA[i].matrícula
            leia TURMA[i].nome
            leia TURMA[i].curso
            leia TURMA[i].coeficiente_de_rendimento
        fim
    
    Para i <- 0 até i < 40 faça passo 1
        inicio
            escreva TURMA[i].nome
            escreva TURMA[i].coeficiente_de_rendimento
        fim

    escreva TURMA[15].coeficiente_de_rendimento
fim algoritmo